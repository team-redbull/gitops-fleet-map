{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {"type": "object"},
    "imagePullSecrets": {"type": "array"},
    "sigsUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
    "day1Url": {"type": "string"},
    "token": {"type": "object"},
    "ca": {"type": "object"},
    "insecure": {"type": "boolean"},
    "interval": {"type": "integer", "minimum": 10},
    "hideValues": {"type": "boolean"},
    "gitRef": {"type": "string"},
    "prefetchRefs": {"type": "string"},
    "maxCachedTrees": {"type": "integer"},
    "proxy": {"type": "object"},
    "extraEnv": {"type": "array"},
    "resources": {"type": "object"},
    "route": {"type": "object"},
    "ingress": {"type": "object"},
    "service": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "podAnnotations": {"type": "object"}
  }
}
